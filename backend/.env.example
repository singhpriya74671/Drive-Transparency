# Local development defaults. Copy this file to .env for local runs.
DATABASE_URL=sqlite:///./drivetransparency.db
SECRET_KEY=change-this-secret-key
DEBUG=True

# JSON list of browser origins allowed to call the API.
# The code default already allows the deployed Vercel app and local dev.
# Production on Render (optional override; include your custom domain if used):
# ALLOWED_ORIGINS=["https://drive-transparency.vercel.app"]
# Local development override:
# ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:19006"]
# PostgreSQL (optional; SQLite is used when DATABASE_URL is not set):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
